generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  username        String   @unique
  password        String
  email           String   @unique
  createdAt       DateTime @default(now())
  isEmailVerified Boolean  @default(false)

  uploads           uploadData[]        @relation("OwnerUploads")
  sharedPhotos      PhotoShare[]        @relation("SharedBy") // ✅ Added
  EmailVerification EmailVerification[]
}

model uploadData {
  id          Int      @id @default(autoincrement())
  photo       String
  description String
  createdAt   DateTime @default(now())

  userId Int
  user   User @relation("OwnerUploads", fields: [userId], references: [id])

  shares PhotoShare[] @relation("PhotoShares")
}

model PhotoShare {
  id      Int        @id @default(autoincrement())
  photo   uploadData @relation("PhotoShares", fields: [photoId], references: [id], onDelete: Cascade)
  photoId Int

  sharedBy   User @relation("SharedBy", fields: [sharedById], references: [id])
  sharedById Int

  sharedWith String
  sharedAt   DateTime @default(now())
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  user   User? @relation(fields: [userId], references: [id])
  userId Int?
}
